# On-prem clinic web container settings (docker-compose.yml next to this file reads it as `.env`).
#
# ONE SOURCE OF TRUTH: the app settings below are the very same EXPO_PUBLIC_* variables, with the same meaning, that you
# set in Vercel (see apps/clinic-app/.env.example). Copy values between the two as-is. On Vercel they are baked in at build time; here
# they are read when the container starts, so changing them only needs `docker compose up -d`.

# --- Infrastructure for this container (not app settings) ---------------------------------------------------------------
CLINIC_WEB_IMAGE=ghcr.io/<owner>/clinicez-clinic-web:latest
CLINIC_NETWORK=<docker network the clinic API runs on>
CLINIC_API_UPSTREAM=http://clinic-api:8080
# CLINIC_WEB_PORT=8080
# CONTAINER_NAME=clinic-web

# --- App settings (same as Vercel) --------------------------------------------------------------------------------------
# Leave unset to use this container's own /api proxy (same origin), which is what a LAN install wants.
# EXPO_PUBLIC_CLINIC_API_URL=https://clinic-api.example.com
# EXPO_PUBLIC_BASE_DOMAIN=example.com
# EXPO_PUBLIC_SERVICE_SUBDOMAIN=clinic
# EXPO_PUBLIC_SERVICE_SUBDOMAINS=clinic,lab,pharmacy,org
# EXPO_PUBLIC_API_URL_TEMPLATE=https://{service}-api.{baseDomain}
# EXPO_PUBLIC_PORTAL_URL=https://example.com
# EXPO_PUBLIC_STORAGE_PUBLIC_URL=https://storage.example.com
# EXPO_PUBLIC_OFFLINE_GRACE_HOURS=12