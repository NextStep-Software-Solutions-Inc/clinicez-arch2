IMAGE_NAME=media-broker
IMAGE_TAG=dev
CONTAINER_NAME=media-broker
ASPNETCORE_ENVIRONMENT=Development
CONNECTION_STRING=Host=postgres;Database=CLINICEZ_MEDIA_DB;Username=<user>;Password=<password>
DB_SCHEMA=media
MEDIA_BROKER_AUTO_MIGRATE=true
MEDIA_BROKER_AUTO_PROVISION=true
HUB_URL=http://interop-hub:8080
MEDIA_HUB_CLIENT_ID=media-broker
MEDIA_HUB_CLIENT_SECRET=<secret>
MEDIA_HUB_SIGNING_KEY=<private-key>
LIVEKIT_URL=wss://media.clinicez.internal
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret0123456789abcdef0123456789abcdef
MEDIA_CPU_SHARES=768
MEDIA_CPUS_RESERVATION=0.10
MEDIA_CPUS_LIMIT=0.95
MEDIA_MEM_RESERVATION=90M
MEDIA_MEM_LIMIT=280M
DATA_NETWORK=data-network
NPM_NETWORK=npm-default
