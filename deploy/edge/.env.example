# .env.example: ClinicEZ Edge Cell (deploy/edge)
#
# You normally do NOT edit this by hand: ./install.sh (or ./install.ps1) asks for the few values the portal gives you,
# generates every secret below and writes .env. This file documents all variables. Copy it to .env only for a manual setup
# (then also run `./install.sh render` to create hub-bootstrap.env from it).
#
# Secret generation (alphanumeric only: the values are embedded in connection strings):
#   bash:        openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})     # fine for a manual setup
#                (install.ps1 uses the cryptographic RNG)

# ==== Images ============================================================================================================
# GitHub owner/repo that publishes the images, lowercase: ghcr.io/<this>/<service>:<tag>
GHCR_OWNER_REPO=nextstep-software-solutions-inc/clinicez-arch2
# Release tag. `./install.sh upgrade --tag <x>` changes it; `latest` follows the main branch.
IMAGE_TAG=latest
# Compose profiles that are switched on. local-hub = the cell's own hub (keep it on for hospitals / several facilities).
# Others: laboratory, pharmacy, organization, cashier. clinic, billing and the clinic web app always run.
COMPOSE_PROFILES=local-hub

# ==== Identity: handed out by the ClinicEZ portal when the on-premise facility is created ===============================
TENANT_ID=<tenant id>
# Edge cell id registered at the cloud hub (HubEdgeCredentials / hub README "Edge sites"). Must not contain ':'.
EDGE_CELL_ID=<edge cell id, e.g. edge-acme>
EDGE_CELL_NAME=Edge site
# One id per facility of this site (the portal facility id; the same id is inside each license). Laboratory, pharmacy and
# organization ids are only needed when that profile is on.
CLINIC_FACILITY_ID=<facility id>
CLINIC_FACILITY_NAME=Clinic
LABORATORY_FACILITY_ID=
LABORATORY_FACILITY_NAME=Laboratory
PHARMACY_FACILITY_ID=
PHARMACY_FACILITY_NAME=Pharmacy
ORGANIZATION_FACILITY_ID=
ORGANIZATION_FACILITY_NAME=Organization
# Domain used in generated verification links and CORS (Facility:BaseDomain). Any value is fine for a LAN-only site.
BASE_DOMAIN=clinic.local

# ==== Which credential is which (the installer asks for / generates exactly these) =======================================
# MODE A, with the local hub (default, COMPOSE_PROFILES contains local-hub):
#   UPSTREAM_HUB_URL / UPSTREAM_CLIENT_ID / UPSTREAM_CLIENT_SECRET = the ONE EdgeCell client (Service 'cell') the portal issued
#                      to this cell = portal "HubEdgeCredentials" (HubUrl, ClientId, ClientSecret). Held by the local hub only.
#   <SERVICE>_HUB_CLIENT_ID / _SECRET (clinic, billing, laboratory, pharmacy, organization) = LOCAL clients site-<service>,
#                      generated by the installer, NOT from the portal.
# MODE B, --no-local-hub (single facility, COMPOSE_PROFILES empty):
#   MESSAGING_HUB_URL = the cloud hub URL (portal HubEdgeCredentials.HubUrl).
#   CLINIC_HUB_CLIENT_ID / _SECRET and BILLING_HUB_CLIENT_ID / _SECRET = the PORTAL-issued per-service EdgeCell clients (the id is
#                      whatever the portal returns; never a site- name). No UPSTREAM_*. laboratory/pharmacy/organization do not run.

# ==== Cloud link of the local hub (mode A only) ==========================================================================
# true  = the hub forwards cross-cell traffic to the cloud hub over outbound HTTPS (needs the three UPSTREAM_* values).
# false = AIR-GAPPED (./install.sh --air-gapped): the hub needs no upstream settings and never talks to the cloud. Only same-cell
#         traffic works; cross-cell / portal / patient messages are REJECTED (reason upstream_disabled, not queued) and the claims
#         endpoints answer 503. To connect later: set true, fill UPSTREAM_*, then ./install.sh apply.
UPSTREAM_ENABLED=true
UPSTREAM_HUB_URL=https://<cloud hub host>
# The EdgeCell client (Service 'cell') the portal created for this cell. The secret is shown ONCE by the portal; rotate it there if lost.
UPSTREAM_CLIENT_ID=<edge client id>
UPSTREAM_CLIENT_SECRET=<edge client secret>
# Cloud portal API (workspace profile / branding fetches; cached on disk for offline use). May be empty when air-gapped
# (compose then uses the unreachable default http://portal.invalid and the app falls back to its cache / built-in branding).
PORTAL_API_URL=https://<portal api host>
# Public absolute URL of the lab-result upload page printed on lab slips ({base}/{token}). It is a CLOUD page (the site only needs
# outbound access; uploaded results are relayed back through the hub). REQUIRED to issue lab orders: may stay empty only when
# air-gapped, and then lab orders cannot be issued until it is set.
CLINIC_PUBLIC_UPLOAD_BASE_URL=https://<cloud lab-upload page host>

# ==== Messaging clients of the services ==================================================================================
# Where every facility service sends and polls. Mode A: the cell hub (leave as is). Mode B: the CLOUD hub URL.
MESSAGING_HUB_URL=http://interop-hub:8080

# Mode A: LOCAL clients, one per service. CREATED BY THE INSTALLER, not by the portal: it generates each secret once (>= 24
# chars, required by the hub) and uses the SAME value in two places: hub-bootstrap.env (Hub__Bootstrap__Clients__N__*) and the
# service's Messaging__ClientSecret. Never share them across sites.
# Mode B: CLINIC_ and BILLING_ below are the portal-issued clients instead (replace the values; LABORATORY_/PHARMACY_/
# ORGANIZATION_ stay empty).
CLINIC_HUB_CLIENT_ID=site-clinic
CLINIC_HUB_CLIENT_SECRET=<generate: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40>
BILLING_HUB_CLIENT_ID=site-billing
BILLING_HUB_CLIENT_SECRET=<generate>
LABORATORY_HUB_CLIENT_ID=site-laboratory
LABORATORY_HUB_CLIENT_SECRET=<generate>
PHARMACY_HUB_CLIENT_ID=site-pharmacy
PHARMACY_HUB_CLIENT_SECRET=<generate>
ORGANIZATION_HUB_CLIENT_ID=site-organization
ORGANIZATION_HUB_CLIENT_SECRET=<generate>

# Base64 of 32 random bytes: encrypts stored envelopes at rest in the hub database (AES-256-GCM).
#   openssl rand -base64 32
#   [Convert]::ToBase64String((1..32 | % {[byte](Get-Random -Max 256)}))
# Keep it OUT of the database backups. If it is lost, undelivered queued messages cannot be read.
HUB_PAYLOAD_ENCRYPTION_KEY=<generate: openssl rand -base64 32>
# Optional host port for the hub (apps outside docker). Loopback only; use HUB_BIND=0.0.0.0 to open it to the LAN.
HUB_BIND=127.0.0.1
HUB_LAN_PORT=8090

# ==== Database (postgres in this stack; never published on a host port) ==================================================
POSTGRES_USER=clinicez
# Alphanumeric only. Do NOT change after the first start (the data volume keeps the old one).
POSTGRES_PASSWORD=<generate: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40>

# ==== Service secrets (generated by the installer) ======================================================================
# Shared by every service in the cell (Internal__ApiKey: service-to-service calls such as clinic -> pharmacy). Stays on the host.
INTERNAL_API_KEY=<generate: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 48>
# Optional pairwise key for clinic -> pharmacy. Empty = INTERNAL_API_KEY.
PHARMACY_API_KEY=
# JWT signing keys, >= 32 bytes. Empty would auto-generate into the /app/keys volume; the installer sets them explicitly.
CLINIC_JWT_SIGNING_KEY=<generate>
BILLING_JWT_SIGNING_KEY=<generate>
LABORATORY_JWT_SIGNING_KEY=<generate>
PHARMACY_JWT_SIGNING_KEY=<generate>
ORGANIZATION_JWT_SIGNING_KEY=<generate>
# Basic Auth password of each API's /hangfire dashboard (user name is ignored). Empty = dashboard denied to everyone.
HANGFIRE_DASHBOARD_PASSWORD=<generate>

# ==== Web apps ==========================================================================================================
# LAN ports of the nginx web apps. Native apps use http://<server>:<port> as their server address.
CLINIC_WEB_PORT=8080
LABORATORY_WEB_PORT=8081
PHARMACY_WEB_PORT=8082
CASHIER_WEB_PORT=8083
# Optional clinic-web settings (same EXPO_PUBLIC_* names as the Vercel build); only the ones you set are published.
# EXPO_PUBLIC_PORTAL_URL=https://example.com
# EXPO_PUBLIC_OFFLINE_GRACE_HOURS=12

# ==== Backups ===========================================================================================================
# Host folder for dumps and file archives: point it at a USB disk or NAS mount. Relative paths are relative to this folder.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
