# .env.example for deploy/billing-api
# The deploy workflow writes the real .env from GitHub secrets; copy this file to .env for a manual run.
# billing-api is a per-cell service: point it at the cell's own (local) interop hub.

IMAGE_NAME=billing-api
IMAGE_TAG=dev
CONTAINER_NAME=billing-api
# Keep Production on servers: Development enables auto-migration and the dev hub credentials.
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL database CLINICEZ_BILLING_DB (schema billing is created by the migrations).
CONNECTION_STRING=Host=postgres;Database=CLINICEZ_BILLING_DB;Username=<user>;Password=<password>
DB_SCHEMA=billing

# The cell's interop hub and the credentials it issued to this service (service "billing").
# The client secret needs at least 24 random characters.
MESSAGING_HUB_URL=http://<cell hub host>:8080
MESSAGING_CLIENT_ID=<billing client id>
MESSAGING_CLIENT_SECRET=<generate: openssl rand -base64 36>
# Envelope signing key of this client: ECDSA P-256 private key, base64 of the PEM (scripts/generate-signing-key.sh). Its public
# half must be the key registered at the hub for this client. Required.
MESSAGING_SIGNING_KEY=<SIGNING_KEY from generate-signing-key>

# Base domain used for the CORS allow-list of the cashier app.
BASE_DOMAIN=<base domain>
# Optional: extra exact CORS origins / extra trusted domains, comma separated. https://<BASE_DOMAIN> and its subdomains are always allowed.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_DOMAINS=

# Provisioning key shared with the portal (X-Internal-Key). It can only create / list / deactivate staff.
INTERNAL_API_KEY=<generate: openssl rand -base64 36>
# Signs the local session tokens. Required, at least 32 characters, e.g. base64 of 64 random bytes (scripts/generate-secrets.sh).
BILLING_JWT_SIGNING_KEY=<generate>

DATA_NETWORK=data-network
NPM_NETWORK=npm-default
