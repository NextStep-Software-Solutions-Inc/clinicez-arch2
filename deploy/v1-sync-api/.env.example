# ============================================================================
# ClinicEZ v1-sync-api Deployment Environment Template
# Copy to `.env` on target host and replace placeholders with real secrets.
#
# All operational & tuning settings (worker enable/disable, poll intervals,
# off-hours backoff, default batch size, pool limit, file transfer concurrency,
# max file size, verification sample rate, and source toggles) are stored in
# SyncLedgerDb (`sync_runtime_settings`) and managed from:
#   Admin Web -> v1 Migration & Sync -> Settings
# ============================================================================

# Container / Image
V1_SYNC_API_IMAGE=clinicez-v1-sync-api:latest
V1_SYNC_PORT=5099
ASPNETCORE_ENVIRONMENT=Production

# Clerk & Portal RBAC (`manage:migrations`) — reuses existing platform env vars
CLERK_AUTHORITY=https://clerk.example.com
CLERK_AUTHORIZED_PARTIES=https://admin.example.com
CORS_ALLOWED_DOMAINS=example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com
BASE_DOMAIN=example.com
PORTAL_API_BASE_URL=http://portal-api:8080

# PostgreSQL Connections (use read-only v1 role for V1_SOURCE_CONNECTION_STRING)
V1_SOURCE_CONNECTION_STRING=Host=v1-db.internal;Port=5432;Database=clinicez_v1;Username=v1_sync_reader;Password=CHANGE_ME;SSL Mode=Require
CLINIC_DB_CONNECTION_STRING=Host=v2-db.internal;Port=5432;Database=clinicez_clinic;Username=v2_clinic_writer;Password=CHANGE_ME;SSL Mode=Require
PATIENT_DB_CONNECTION_STRING=Host=v2-db.internal;Port=5432;Database=clinicez_patient;Username=v2_patient_writer;Password=CHANGE_ME;SSL Mode=Require
SYNC_LEDGER_DB_CONNECTION_STRING=Host=v2-db.internal;Port=5432;Database=clinicez_v1_sync;Username=v1_sync_ledger;Password=CHANGE_ME;SSL Mode=Require

# ============================================================================
# Object Storage Credentials (reuses existing Clinic & Patient R2 secrets)
# If Clinic and Patient share one Cloudflare R2 account/key, set R2_* once and
# override only CLINIC_R2_BUCKET_NAME / PATIENT_R2_BUCKET_NAME.
# Leave *_S3_SERVICE_URL blank for Cloudflare R2; set only for local MinIO/S3.
# ============================================================================
CLINIC_R2_ACCOUNT_ID=CHANGE_ME
CLINIC_R2_BUCKET_NAME=clinicez-clinic-prod
CLINIC_R2_ACCESS_KEY_ID=CHANGE_ME
CLINIC_R2_SECRET_ACCESS_KEY=CHANGE_ME
# CLINIC_S3_SERVICE_URL=

PATIENT_R2_ACCOUNT_ID=CHANGE_ME
PATIENT_R2_BUCKET_NAME=clinicez-patient-prod
PATIENT_R2_ACCESS_KEY_ID=CHANGE_ME
PATIENT_R2_SECRET_ACCESS_KEY=CHANGE_ME
# PATIENT_S3_SERVICE_URL=

# Envelope Master Secrets (reuses exact clinic-api & patient-api secrets; >= 32 chars)
CLINIC_ENCRYPTION_MASTER_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
CLINIC_ENCRYPTION_PREVIOUS_MASTER_SECRET_0=
CLINIC_ENCRYPTION_PREVIOUS_MASTER_SECRET_1=
PATIENT_ENCRYPTION_MASTER_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
PATIENT_ENCRYPTION_PREVIOUS_MASTER_SECRET_0=
PATIENT_ENCRYPTION_PREVIOUS_MASTER_SECRET_1=
