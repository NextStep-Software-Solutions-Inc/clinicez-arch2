# ============================================================================
# ClinicEZ v1-sync-api Nginx Reverse Proxy Template
# Routes HTTPS traffic to loopback-bound v1-sync-api (127.0.0.1:5099).
# ============================================================================

server {
    listen 443 ssl http2;
    server_name v1-sync.example.com;

    ssl_certificate     /etc/letsencrypt/live/v1-sync.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/v1-sync.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Security headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://127.0.0.1:5099;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Extended timeout for manual backfill / final-sweep operations
        proxy_connect_timeout 15s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }
}
