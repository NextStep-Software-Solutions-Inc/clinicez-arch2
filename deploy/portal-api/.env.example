# .env.example for deploy/portal-api
# The deploy workflows (deploy-portal-api-dev.yml / -prod.yml) write the real .env from GitHub secrets and variables; copy
# this file to .env for a manual run. Every variable is explained in docs/deployment-configuration.md.

IMAGE_NAME=portal-api
IMAGE_TAG=latest
CONTAINER_NAME=portal-api
ENVIRONMENT_LABEL=prod
# Keep Production on servers: Development enables the dev Clerk authority fallback and the log-only mail mode.
ASPNETCORE_ENVIRONMENT=Production

# ---- Database ------------------------------------------------------------------------------------------------------------
CONNECTION_STRING=Host=postgres;Database=CLINICEZ_PORTAL_DB;Username=<user>;Password=<password>

# ---- Identity and payments -----------------------------------------------------------------------------------------------
CLERK_SECRET_KEY=<Clerk backend secret key>
# Issuer tokens are validated against. Required (the API only falls back to a development issuer in Development).
CLERK_AUTHORITY=https://<your-instance>.clerk.accounts.dev
# Extra trusted token origins, comma separated. https://<BASE_DOMAIN> and https://*.<BASE_DOMAIN> are added automatically.
CLERK_AUTHORIZED_PARTIES=
XENDIT_SECRET_KEY=<Xendit secret key>
XENDIT_CALLBACK_TOKEN=<Xendit webhook verification token>
# Web portal base URL, used for billing redirects when a request carries no Origin/Referer.
FRONTEND_BASE_URL=

# ---- Interop hub ---------------------------------------------------------------------------------------------------------
# The cloud hub and portal-api's ControlPlane client. The client secret needs at least 24 random characters.
MESSAGING_HUB_URL=http://interop-hub:8080
MESSAGING_CLIENT_ID=<portal client id>
MESSAGING_CLIENT_SECRET=<generate: openssl rand -base64 36>
# Envelope signing key of the portal's hub client: ECDSA P-256 private key, base64 of the PEM (scripts/generate-signing-key.sh).
# Its public half is the cloud hub's HUB_PORTAL_PUBLIC_KEY. Required.
MESSAGING_SIGNING_KEY=<SIGNING_KEY from generate-signing-key>
# Public address of the cloud hub, handed to on-premise sites together with their one-time credentials.
HUB_PUBLIC_URL=https://<hub public host>
# Cell hosting every shared-cloud facility. Must equal the cloud hub's Hub__CloudCellId.
HUB_CLOUD_CELL_ID=cloud

# ---- Facility license keys (ECDSA P-256, base64 of PEM; scripts/generate-license-keys.sh) ------------------------------------
# The portal signs licenses with the PRIVATE key. It lives ONLY here (never on edge servers or in other services).
FACILITY_LICENSE_PRIVATE_KEY=<FACILITY_LICENSE_PRIVATE_KEY from generate-license-keys>
# The portal validates with the public key too; the same value goes to clinic/laboratory/pharmacy/organization and the edge bundle.
FACILITY_LICENSE_PUBLIC_KEY=<FACILITY_LICENSE_PUBLIC_KEY from generate-license-keys>
# Only during a rotation: the previous public key stays accepted until every issued license was renewed.
FACILITY_LICENSE_PUBLIC_KEY_PREVIOUS=

# ---- Facilities ----------------------------------------------------------------------------------------------------------
BASE_DOMAIN=<base domain>
# Optional: extra exact CORS origins / extra trusted domains, comma separated. https://<BASE_DOMAIN> and its subdomains are always allowed.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_DOMAINS=
# Shared secret the portal presents to facility APIs (X-Internal-Key); philhealth-proxy presents the same value to the portal.
INTERNAL_API_KEY=<generate: openssl rand -base64 36>
# Only during a rotation: the old key stays accepted until every caller uses the new one, then remove it.
INTERNAL_API_KEY_PREVIOUS=
# Clinic API the portal calls with the internal key.
SERVICES_CLINIC_API_URL=http://clinic-api:8080
HANGFIRE_DASHBOARD_PASSWORD=<generate: openssl rand -base64 24>

# ---- Mail (the host fails to start without SMTP_HOST and SMTP_FROM_EMAIL) --------------------------------------------------
SMTP_HOST=<smtp host>
SMTP_PORT=587
# Auto, None, StartTls or SslOnConnect
SMTP_SECURITY=Auto
# Empty user means no authentication.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=<sender address>
SMTP_FROM_NAME=Clinic EZ
SMTP_REPLY_TO=
# Recipient of the public contact form. Empty disables it.
NOTIFICATIONS_CONTACT_INBOX=

# ---- Product limits (defaults shown; leave empty to use them) -------------------------------------------------------------
WORKSPACE_MAX_OWNED_PER_USER=1
# Public lab-result upload relay.
LAB_UPLOAD_MAX_FILE_BYTES=5242880
LAB_UPLOAD_RATE_LIMIT_PERMITS=20
LAB_UPLOAD_RATE_LIMIT_WINDOW_MINUTES=10
# Facility license lifetime (clamped to 30-90 days), read-only grace after expiry, renewal lead time.
LICENSING_TTL_DAYS=30
LICENSING_GRACE_DAYS=14
LICENSING_RENEW_BEFORE_DAYS=10
# Plan a new workspace starts on and its trial length. The plan catalog itself is in the portal's appsettings.json.
BILLING_DEFAULT_PLAN_SLUG=starter
BILLING_TRIAL_DAYS=14

# ---- Data Protection key ring --------------------------------------------------------------------------------------------
# The ring lives on the portal-api-dpkeys volume (/var/dpkeys): keep that volume; the ring rotates automatically.
# Optional key-at-rest protection: a PFX certificate as base64 (one line) and its password. Empty = ring stored unencrypted.
DATA_PROTECTION_CERT_BASE64=
DATA_PROTECTION_CERT_PASSWORD=

DATA_NETWORK=data-network
NPM_NETWORK=npm-default
