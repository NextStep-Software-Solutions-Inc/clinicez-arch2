# .env.example for deploy/interop-hub
# The deploy workflow writes the real .env from GitHub secrets; copy this file to .env for a manual run.

# --- Cloud hub (docker-compose.yml) -------------------------------------------------------------------------------------
IMAGE_NAME=interop-hub
IMAGE_TAG=dev
CONTAINER_NAME=interop-hub
# Keep Production on servers: Development seeds well-known dev-* clients.
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL database CLINICEZ_INTEROP_HUB_DB (schema public is created by the migrations).
CONNECTION_STRING=Host=postgres;Database=CLINICEZ_INTEROP_HUB_DB;Username=<user>;Password=<password>
DB_SCHEMA=public
HUB_AUTO_MIGRATE=true

# Optional: base64 of 32 random bytes (openssl rand -base64 32). Empty = envelopes stored as plain JSON.
HUB_PAYLOAD_ENCRYPTION_KEY=

# First ControlPlane client (portal-api). At least 24 random characters; portal-api uses the same values as its
# PORTAL_HUB_CLIENT_ID / PORTAL_HUB_CLIENT_SECRET. Everything else is created through the hub admin API.
HUB_CLOUD_CELL_ID=cloud
PORTAL_HUB_CLIENT_ID=portal-api
PORTAL_HUB_CLIENT_SECRET=<generate: openssl rand -base64 36>
PORTAL_HUB_SIGNING_PUBLIC_KEY=<SIGNING_PUBLIC_KEY from generate-signing-key>

# Cloud service clients (clinic, lab, pharmacy, billing, organization, patient)
CLINIC_HUB_CLIENT_ID=dev-clinic
CLINIC_HUB_CLIENT_SECRET=<secret>
CLINIC_HUB_SIGNING_PUBLIC_KEY=<public-key>

LABORATORY_HUB_CLIENT_ID=dev-laboratory
LABORATORY_HUB_CLIENT_SECRET=<secret>
LABORATORY_HUB_SIGNING_PUBLIC_KEY=<public-key>

PHARMACY_HUB_CLIENT_ID=dev-pharmacy
PHARMACY_HUB_CLIENT_SECRET=<secret>
PHARMACY_HUB_SIGNING_PUBLIC_KEY=<public-key>

BILLING_HUB_CLIENT_ID=dev-billing
BILLING_HUB_CLIENT_SECRET=<secret>
BILLING_HUB_SIGNING_PUBLIC_KEY=<public-key>

ORGANIZATION_HUB_CLIENT_ID=dev-organization
ORGANIZATION_HUB_CLIENT_SECRET=<secret>
ORGANIZATION_HUB_SIGNING_PUBLIC_KEY=<public-key>

PATIENT_HUB_CLIENT_ID=dev-patient
PATIENT_HUB_CLIENT_SECRET=<secret>
PATIENT_HUB_SIGNING_PUBLIC_KEY=<public-key>

# Verify envelope signatures on POST /v1/messages. Default true; set false only temporarily for clients that cannot sign yet.
HUB_SIGNING_REQUIRED=true

# ---- Resource Allocation (Production VPS 1 vCPU / 2GB RAM Standard) -----------------------------------------
# Dynamic proportional sharing: no idle resources wasted; active services burst to 100% host capacity.
HUB_CPU_SHARES=1024
HUB_CPUS_RESERVATION=0.15
HUB_CPUS_LIMIT=0.95
HUB_MEM_RESERVATION=120M
HUB_MEM_LIMIT=350M

# --- Local (edge) hub (docker-compose.local-hub.yml) --------------------------------------------------------------------
LOCAL_CELL_ID=<cell id registered in the portal, e.g. edge-acme>
LOCAL_CELL_NAME=<site name>
LOCAL_TENANT_ID=<tenant that owns the site>
LOCAL_HUB_PORT=8080
LOCAL_DB_NAME=CLINICEZ_INTEROP_HUB_LOCAL_DB
LOCAL_DB_USER=interop_hub
LOCAL_DB_PASSWORD=<password>

# false = air-gapped single site: same-cell traffic only, nothing is forwarded to the cloud, the three values below are not needed.
UPSTREAM_ENABLED=true
# The credentials the cloud hub issued for this cell (an EdgeCell client with service "cell").
UPSTREAM_HUB_URL=https://<cloud hub host>
UPSTREAM_CLIENT_ID=<edge cell client id>
UPSTREAM_CLIENT_SECRET=<edge cell client secret>
# P-256 private key (base64 of PEM) the portal issued together with the edge cell client: the local hub re-signs forwarded envelopes
# with it. Not needed when UPSTREAM_ENABLED=false.
EDGE_HUB_SIGNING_KEY=<edge hub signing key>

# The site's own service clients and facilities (the same ones the portal registered for this cell).
LOCAL_CLINIC_CLIENT_ID=site-clinic
LOCAL_CLINIC_CLIENT_SECRET=<at least 24 random characters>
# Public half of the clinic service's Messaging__SigningKey (base64 of a P-256 public PEM; scripts/generate-signing-key.sh).
LOCAL_CLINIC_PUBLIC_KEY=<SIGNING_PUBLIC_KEY of the clinic service>
LOCAL_CLINIC_FACILITY_ID=<facility id>
LOCAL_CLINIC_NAME=<facility name>
