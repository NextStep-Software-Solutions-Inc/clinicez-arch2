# RabbitMQ broker settings (docker-compose.yml next to this file reads it as `.env`).
# Use the same username/password as the RABBITMQ_USERNAME / RABBITMQ_PASSWORD given to the API stacks.

# Required. Generate one, e.g.: openssl rand -base64 32
RABBITMQ_PASSWORD=

# RABBITMQ_USERNAME=rabbit_admin_node
# RABBITMQ_CONTAINER_NAME=rabbitmq
# RABBITMQ_MANAGEMENT_PORT=15672