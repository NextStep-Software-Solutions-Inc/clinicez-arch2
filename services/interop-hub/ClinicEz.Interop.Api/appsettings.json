{
  "DbSchema": "public",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hub": {
    "Mode": "Cloud",
    "CloudCellId": "cloud",
    "LocalCellId": "",
    "MaxEnvelopeBytes": 1048576,
    "MaxSendBatch": 100,
    "MessageTtlDays": 7,
    "MaxDeliveryAttempts": 10,
    "VisibilityTimeoutSeconds": 60,
    "NackDelaySeconds": 5,
    "DeadLetterRetentionDays": 14,
    "ConversationRetentionDays": 30,
    "MaxPullBatch": 100,
    "MaxLongPollSeconds": 25,
    "LongPollIntervalMs": 1000,
    "PayloadEncryptionKey": "",
    "Auth": {
      "Pbkdf2Iterations": 100000,
      "CacheSeconds": 30,
      "MinBootstrapSecretLength": 24
    },
    "Claims": {
      "DefaultTtlHours": 168,
      "MaxTtlHours": 720
    },
    "Database": {
      "AutoMigrate": false
    },
    "Background": {
      "Enabled": true,
      "MaintenanceIntervalSeconds": 30
    },
    "Upstream": {
      "Url": "",
      "ClientId": "",
      "ClientSecret": "",
      "PollWaitSeconds": 20,
      "BatchSize": 50,
      "ForwardIntervalMs": 1000,
      "MaxBackoffSeconds": 300,
      "DirectorySyncSeconds": 60
    }
  }
}
