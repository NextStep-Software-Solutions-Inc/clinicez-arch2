{
  "DbSchema": "clinic_dashboard",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "clinicez-clinic",
    "Audience": "clinicez-clinic",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 10
  },
  "Auth": {
    "RateLimitPerMinute": 30
  },
  "Features": {
    "YakapSimulation": false
  },
  "Cors": {
    "AllowAnyOrigin": true
  },
  "Messaging": {
    "Transport": "Hub",
    "HubUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "Service": "clinic"
  },
  "Services": {
    "PortalApiUrl": "http://portal-api:8080",
    "PharmacyApiUrl": "http://pharmacy-api:8080"
  },
  "Facility": {
    "Subdomains": {
      "Clinic": "clinic",
      "Laboratory": "lab",
      "Pharmacy": "pharmacy",
      "Organization": "org"
    }
  }
}