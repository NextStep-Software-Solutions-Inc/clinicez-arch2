{
  "DbSchema": "public",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "clinicez-clinic",
    "Audience": "clinicez-clinic",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 10
  },
  "Auth": {
    "RateLimitPerMinute": 30
  },
  "Features": {
    "YakapSimulation": false
  },
  "Storage": {
    "Provider": "Local",
    "BasePath": "Storage/Records",
    "EnableLocalFallback": true
  },
  "S3": {
    "ServiceUrl": "",
    "BucketName": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "auto",
    "ForcePathStyle": true,
    "AccountId": "",
    "PublicUrl": ""
  },
  "R2": {
    "AccountId": "",
    "BucketName": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "PublicUrl": ""
  },
  "Clinic": {
    "PublicUploadBaseUrl": "",
    "UploadMaxBytes": 10485760,
    "UploadAllowedContentTypes": [ "application/pdf", "image/jpeg", "image/png" ],
    "UploadGrantTtlDays": 30,
    "UploadMaxUploads": 3
  },
  "Messaging": {
    "Transport": "Hub",
    "HubUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "SigningKey": "",
    "Service": "clinic"
  },
  "Documents": {
    "SigningKey": ""
  },
  "Gamot": {
    "PharmacyFacilityId": ""
  },
  "Facility": {
    "Subdomains": {
      "Clinic": "clinic",
      "Laboratory": "lab",
      "Pharmacy": "pharmacy",
      "Organization": "org"
    }
  }
}
