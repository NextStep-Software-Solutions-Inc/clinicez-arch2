{
  "DbSchema": "public",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "clinicez-lab",
    "Audience": "clinicez-lab",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 10
  },
  "Auth": {
    "RateLimitPerMinute": 30
  },
  "Messaging": {
    "Transport": "Hub",
    "HubUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "Service": "laboratory"
  },
  "Facility": {
    "Subdomains": {
      "Clinic": "clinic",
      "Laboratory": "lab",
      "Pharmacy": "pharmacy",
      "Organization": "org"
    }
  }
}