{
  "DbSchema": "laboratory_dashboard",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "clinicez-lab",
    "Audience": "clinicez-lab",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 10
  },
  "Auth": {
    "RateLimitPerMinute": 30
  },
  "Cors": {
    "AllowAnyOrigin": true
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Username": "rabbit_admin_node"
  },
  "Services": {
    "PortalApiUrl": "http://portal-api:8080"
  },
  "Facility": {
    "Subdomains": {
      "Clinic": "clinic",
      "Laboratory": "lab",
      "Pharmacy": "pharmacy",
      "Organization": "org"
    }
  }
}