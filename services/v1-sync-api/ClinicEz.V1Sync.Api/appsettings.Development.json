{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "ClinicDb": "Host=127.0.0.1;Port=5439;Database=CLINICEZ-CLINIC_DB;Username=clinicez_local;Password=clinicez_local_dev_password;Maximum Pool Size=4",
    "PatientDb": "Host=127.0.0.1;Port=5439;Database=CLINICEZ-PATIENT_DB;Username=clinicez_local;Password=clinicez_local_dev_password;Maximum Pool Size=4",
    "SyncLedgerDb": "Host=127.0.0.1;Port=5439;Database=CLINICEZ-V1_SYNC_DB;Username=clinicez_local;Password=clinicez_local_dev_password;Maximum Pool Size=4"
  },
  "V1Sync": {
    "EnvironmentLabel": "LOCAL_DEV",
    "MaxPoolSize": 4,
    "BatchSize": 200,
    "AllowUnauthenticatedLocalDev": true
  },
  "Track3Storage": {
    "Enabled": true,
    "MaxConcurrency": 6,
    "MaxFileSizeBytes": 52428800,
    "VerificationSampleRate": 0.02,
    "AzureBlob1Enabled": true,
    "AzureBlob1OriginOverride": "",
    "ClinicR2": {
      "ServiceUrl": "http://127.0.0.1:9000",
      "BucketName": "clinicez-clinic-local",
      "AccessKeyId": "minioadmin",
      "SecretAccessKey": "minioadmin",
      "Region": "us-east-1",
      "ForcePathStyle": true
    },
    "PatientR2": {
      "ServiceUrl": "http://127.0.0.1:9000",
      "BucketName": "clinicez-patient-local",
      "AccessKeyId": "minioadmin",
      "SecretAccessKey": "minioadmin",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "ClinicEncryption": {
    "MasterSecret": "dev-only-clinic-encryption-secret-never-use-in-production"
  },
  "PatientEncryption": {
    "MasterSecret": "dev-patient-encryption-master-secret-32chars-min-ok!"
  }
}
