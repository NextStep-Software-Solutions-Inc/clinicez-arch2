# Environment variables for PhilHealth Proxy local development and container deployments
# Copy this file to .env and configure secrets accordingly.
# .env is gitignored and should never be committed to source control.

# ─── Environment ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ─── PostgreSQL Container Connection String ──────────────────────────────────
# When running within Docker network alongside postgres container:
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=patientapp_db;Username=patientapp;Password=patientapp_secret
#
# When connecting from Docker Desktop to host machine PostgreSQL:
# ConnectionStrings__DefaultConnection=Host=host.docker.internal;Port=5432;Database=patientapp_db;Username=patientapp;Password=patientapp_secret
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=patientapp_db;Username=patientapp;Password=patientapp_secret

# ─── PhilHealth SOAP Sandbox / Gateway Mode ──────────────────────────────────
# Set to 'true' to use the built-in offline SOAP sandbox mock service
PhilHealth__UseSandbox=true
