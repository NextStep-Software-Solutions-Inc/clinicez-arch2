# Environment variables for PhilHealth Proxy local development and container deployments
# Copy this file to .env and configure accordingly.
# .env is gitignored and should never be committed to source control.

# ─── Environment ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ─── Portal API Endpoint (Zero-DB Credential Resolution) ─────────────────────
# PhilHealth Proxy has ZERO database requirements.
# It resolves branch & tenant PhilHealth accreditation credentials from portal-api.
PortalApi__BaseUrl=http://portal-api:8080

# ─── PhilHealth SOAP Sandbox / Gateway Mode ──────────────────────────────────
# Set to 'true' to use the built-in offline SOAP sandbox mock service
PhilHealth__UseSandbox=true
