{
  "DbSchema": "billing",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "clinicez-billing",
    "Audience": "clinicez-billing",
    "AccessTokenMinutes": 600,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 10
  },
  "Auth": {
    "RateLimitPerMinute": 30
  },
  "Cors": {
    "AllowAnyOrigin": true
  },
  "Messaging": {
    "Transport": "Hub",
    "HubUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "Service": "billing"
  }
}
