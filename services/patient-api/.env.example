# Environment variables for local development (deploy/patient-api/docker-compose.local*.yml)
# Copy this file to .env and fill in real values.
# .env is gitignored; this file is committed as documentation only.

# ─── PostgreSQL (local dev only) ─────────────────────────────────────────────
POSTGRES_USER=patientapp
POSTGRES_PASSWORD=changeme_in_production

# ─── Deploy: Database Connection String ──────────────────────────────────────
# Used by deploy/patient-api/docker-compose.yml (production/dev server deployments).
# Format: Host=<host>;Port=5432;Database=patientapp_db;Username=<user>;Password=<pass>
CONNECTION_STRING=Host=localhost;Port=5432;Database=patientapp_db;Username=patientapp;Password=changeme_in_production

# ─── Clerk Authentication ─────────────────────────────────────────────────────
CLERK_AUTHORITY=https://clerk.your-domain.com
# Leave CLERK_AUDIENCE blank when using standard Clerk session tokens (they contain no 'aud' claim)
CLERK_AUDIENCE=
# Clerk Webhook Signing Secret (Optional: required only when processing Clerk webhooks)
CLERK_WEBHOOK_SECRET=whsec_your_secret_here

# ─── Cloudflare R2 Storage ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET_NAME=Clinic EZ-patient-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ─── Hangfire Dashboard Basic Auth ───────────────────────────────────────────
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=changeme_in_production

# ─── Required secrets (no defaults; the service refuses to start without them) ─
# HMAC key for share-token QR codes, at least 32 characters. Maps to Sharing__SigningKey.
SHARING_SIGNING_KEY=<generate>