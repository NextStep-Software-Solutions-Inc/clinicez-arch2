# ─────────────────────────────────────────────────────────────────
# Root .easignore – Monorepo EAS Build Exclusions
# Note: When .easignore is present at the VCS root, EAS CLI uses it
# INSTEAD of .gitignore — so node_modules and build outputs MUST be
# excluded here while keeping all Bun workspace package directories!
# ─────────────────────────────────────────────────────────────────

# ── Node / Build / Framework Outputs ──────────────────────────────
**/node_modules/
**/.pnp/
**/.next/
**/.vercel/
**/.expo/
**/.expo-shared/
**/dist/
**/web-build/
**/build/
**/out/
**/coverage/
*.tsbuildinfo
/apps/patient-app/android/
/apps/patient-app/ios/
/apps/clinic-app/android/
/apps/clinic-app/ios/

# ── .NET Backend Services (ROOT ONLY — DO NOT match apps/*/services/!) ──
/services/
/packages/shared-dotnet/
/packages/shared-dotnet.Tests/
**/bin/
**/obj/
*.sln
*.csproj
.vs/

# ── Heavy Web Marketing Assets (keep workspace package.json intact) ─
/apps/portal-web/public/

# ── Local Database & Secrets ──────────────────────────────────────
*.db
*.db-shm
*.db-wal
.env
.env.local
.env.*.local
secrets.json
configuration*.txt
credentials*.txt
/keys/

# ── Dev tooling, agent metadata, logs & VCS ───────────────────────
.DS_Store
Thumbs.db
*.log
/.agents/
/.github/
/.git/
/.vscode/
/.idea/
*.md
!README.md

# ── Lockfile & Workspace Inclusions (MANDATORY) ───────────────────
!bun.lock
!bunfig.toml
!/apps/patient-app/bunfig.toml
!/packages/
!/apps/
