{
  "name": "clinicez-monorepo",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint:portal": "bun --cwd apps/portal-web lint",
    "test:portal": "bun test apps/portal-web/tests",
    "typecheck:portal": "tsc --noEmit -p apps/portal-web",
    "dev:marketing": "bun --cwd apps/marketing-web dev",
    "lint:marketing": "bun --cwd apps/marketing-web lint",
    "typecheck:marketing": "tsc --noEmit -p apps/marketing-web",
    "test:marketing": "bun test apps/marketing-web/tests",
    "build:marketing": "bun run --cwd apps/marketing-web build",
    "dev:admin": "bun --cwd apps/admin-web dev",
    "lint:admin": "bun --cwd apps/admin-web lint",
    "typecheck:admin": "tsc --noEmit -p apps/admin-web",
    "test:admin": "bun test apps/admin-web/tests",
    "build:admin": "bun run --cwd apps/admin-web build",
    "typecheck:patient": "tsc --noEmit -p apps/patient-app",
    "lint:tokens": "bun apps/clinic-app/scripts/check-tokens.mjs && bun apps/patient-app/scripts/check-tokens.mjs",
    "lint:patient-tokens": "bun apps/patient-app/scripts/check-tokens.mjs",
    "test:tokens": "bun --cwd packages/design-tokens test",
    "test:patient": "bun test apps/patient-app/tests",
    "typecheck:clinic": "tsc --noEmit -p apps/clinic-app",
    "test:clinic": "bun --cwd apps/clinic-app test --isolate --timeout 20000 tests",
    "lint:clinic": "bun apps/clinic-app/scripts/check-tokens.mjs && bun apps/clinic-app/scripts/check-no-external-hosts.mjs",
    "typecheck:lab": "tsc --noEmit -p apps/laboratory-app",
    "typecheck:pharmacy": "tsc --noEmit -p apps/pharmacy-app",
    "typecheck:cashier": "tsc --noEmit -p apps/cashier-app",
    "typecheck:comms": "tsc --noEmit -p packages/comms-sdk",
    "lint:comms": "bun packages/comms-sdk/scripts/check-tokens.mjs --strict && bun packages/comms-sdk/scripts/check-no-external-hosts.mjs",
    "test:comms": "bun test packages/comms-sdk/tests",
    "typecheck:all": "tsc --noEmit -p packages/comms-sdk && tsc --noEmit -p apps/patient-app && tsc --noEmit -p apps/clinic-app && tsc --noEmit -p apps/laboratory-app && tsc --noEmit -p apps/pharmacy-app && tsc --noEmit -p apps/cashier-app && tsc --noEmit -p apps/admin-web && tsc --noEmit -p apps/marketing-web",
    "build:portal": "bun run --cwd apps/portal-web build",
    "build:patient-web": "bun run --cwd apps/patient-app build:web",
    "build:clinic-web": "bun run --cwd apps/clinic-app build:web",
    "build:cashier-web": "bun run --cwd apps/cashier-app build:web",
    "build:lab-web": "bun run --cwd apps/laboratory-app build:web",
    "build:pharmacy-web": "bun run --cwd apps/pharmacy-app build:web",
    "seed:dev": "powershell -ExecutionPolicy Bypass -File scripts/seed-dev-patients.ps1"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
