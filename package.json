{
  "name": "clinicez-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint:portal": "bun --cwd apps/portal-web lint",
    "typecheck:patient": "tsc --noEmit -p apps/patient-app",
    "lint:patient-tokens": "node apps/patient-app/scripts/check-tokens.mjs",
    "test:tokens": "bun --cwd packages/design-tokens test",
    "test:patient": "bun --cwd apps/patient-app test",
    "typecheck:clinic": "tsc --noEmit -p apps/clinic-app",
    "test:clinic": "bun --cwd apps/clinic-app test",
    "lint:clinic": "node apps/clinic-app/scripts/check-tokens.mjs && node apps/clinic-app/scripts/check-no-external-hosts.mjs",
    "typecheck:lab": "tsc --noEmit -p apps/laboratory-app",
    "typecheck:pharmacy": "tsc --noEmit -p apps/pharmacy-app",
    "typecheck:cashier": "tsc --noEmit -p apps/cashier-app",
    "typecheck:all": "tsc --noEmit -p apps/patient-app && tsc --noEmit -p apps/clinic-app && tsc --noEmit -p apps/laboratory-app && tsc --noEmit -p apps/pharmacy-app && tsc --noEmit -p apps/cashier-app",
    "build:portal": "bun --cwd apps/portal-web build",
    "build:patient-web": "bun --cwd apps/patient-app build:web",
    "build:clinic-web": "bun --cwd apps/clinic-app build:web"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
