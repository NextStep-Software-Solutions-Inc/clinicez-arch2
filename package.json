{
  "name": "clinicez-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint:portal": "bun --filter @clinicez/portal-web lint",
    "typecheck:patient": "tsc --noEmit -p apps/patient-app",
    "lint:patient-tokens": "bun --filter @clinicez/patient-app lint:tokens",
    "test:tokens": "bun --cwd packages/design-tokens test",
    "test:patient": "bun --filter @clinicez/patient-app test",
    "typecheck:clinic": "tsc --noEmit -p apps/clinic-app",
    "test:clinic": "bun --filter @clinicez/clinic-app test",
    "lint:clinic": "bun --filter @clinicez/clinic-app lint:tokens && bun --filter @clinicez/clinic-app lint:hosts",
    "typecheck:lab": "tsc --noEmit -p apps/laboratory-app",
    "typecheck:pharmacy": "tsc --noEmit -p apps/pharmacy-app",
    "typecheck:cashier": "tsc --noEmit -p apps/cashier-app",
    "typecheck:all": "tsc --noEmit -p apps/patient-app && tsc --noEmit -p apps/clinic-app && tsc --noEmit -p apps/laboratory-app && tsc --noEmit -p apps/pharmacy-app && tsc --noEmit -p apps/cashier-app",
    "build:portal": "bun --filter @clinicez/portal-web build",
    "build:patient-web": "bun --filter @clinicez/patient-app build:web",
    "build:clinic-web": "bun --filter @clinicez/clinic-app build:web"
  }
}
