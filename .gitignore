*.cache
.vs/

# Rider
.idea/

# Visual Studio Code
.vscode/

# NuGet
# The legacy `packages/` folder for NuGet is not ignored at the repository root because
# this monorepo stores actual packages in the top-level `packages/` directory. Instead,
# ignore only the common build output locations for packages.
/*.nupkg
/**/*.nupkg
/project.lock.json
/project.fragment.lock.json
/project.nuget.cache
*.userprefs

# Build results
/build/
/out/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / JavaScript
node_modules/
/.pnp/
.pnp.js

# Next.js / Vercel
.next/
.vercel/

# Expo / React Native
.expo/
.expo-shared/
android/app/build/
android/.gradle/
android/.idea/
ios/Pods/
ios/build/

# macOS
.DS_Store

# Windows
Thumbs.db

# Environment / secrets
.env
.env.*.local
secrets.json

# Misc editors
*~
*.swp
*.swo

# Coverage
coverage/

# Ignore local package manager files that are safe to ignore
/*.log

# Ignore generated obj files under any package (explicit)
packages/**/bin/
packages/**/obj/

# Ignore any .vs folders at repo level
.vs/
