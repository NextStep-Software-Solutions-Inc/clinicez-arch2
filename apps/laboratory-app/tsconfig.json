{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strict": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["components/ui/*"],
      "@ui": ["components/ui"],
      "@services/*": ["services/*"],
      "@screens/*": ["navigation/screens/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".expo", "tests"]
}
