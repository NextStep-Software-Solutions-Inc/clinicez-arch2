# ---------------------------------------------------------------------------
# ClinicEZ Standalone Admin Panel (@clinicez/admin-web)
# Served on https://admin.<base-domain> (local dev: http://localhost:3001)
# VITE_* values are inlined into the static SPA bundle at build time.
# ---------------------------------------------------------------------------

# Portal API Root URL (strictly portal-api; never direct to clinic-api)
VITE_PORTAL_API_URL=http://localhost:5000/api/v1

# Shared platform base domain (e.g. example.com) used to construct
# external tenant workspace ({slug}.<base-domain>) and public marketing/blog links
VITE_BASE_DOMAIN=example.com

# Optional explicit Tenant Portal & Marketing Web origin overrides for local dev
VITE_PORTAL_WEB_URL=http://localhost:3000
VITE_MARKETING_WEB_URL=http://localhost:3002

# Clerk Authentication (frontend publishable key only; no secret key needed)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Exclusive Admin Security Hardening
# Cross-tab inactivity timeout in minutes (default: 15, with 60s warning modal)
VITE_ADMIN_IDLE_TIMEOUT_MINUTES=15

# Enforce Clerk 2FA / TOTP enrollment before accessing governance routes
# Set to false in local dev; recommended true in production
VITE_ADMIN_REQUIRE_MFA=false

# Optional explicit header environment badge override (local | dev | prod)
# Auto-detected from hostname, Vercel preview/dev URLs, upstream dev URLs, and Clerk key prefix when omitted
# VITE_APP_ENV=dev
