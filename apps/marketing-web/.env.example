# ---------------------------------------------------------------------------
# Clinic EZ Public Marketing Web (@clinicez/marketing-web)
# Served on https://<base-domain>, https://www.<base-domain>, and https://home.<base-domain>
# Local dev: http://localhost:3002 (pure static/ISR — zero Clerk dependency)
# ---------------------------------------------------------------------------

# Shared platform base domain (e.g. example.com) used to derive:
# - Canonical SEO origin: https://<base-domain>
# - Tenant Portal CTA origin: https://portal.<base-domain>
# - Portal API endpoint: https://portal-api.<base-domain>/api/v1
NEXT_PUBLIC_BASE_DOMAIN=example.com

# Optional explicit origin overrides (useful in local development)
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Portal API configuration for /public/plans, /public/blogs, /contact, /newsletter/subscribe
NEXT_PUBLIC_PORTAL_API_URL=http://localhost:5000/api/v1
PORTAL_API_URL=http://localhost:5000/api/v1

# Optional public contact mailboxes (hidden in UI when empty)
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NEXT_PUBLIC_SALES_EMAIL=sales@example.com
# NEXT_PUBLIC_BILLING_EMAIL=billing@example.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
