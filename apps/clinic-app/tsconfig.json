{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strict": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["components/ui/*"],
      "@ui": ["components/ui"],
      "@layout/*": ["components/layout/*"],
      "@layout": ["components/layout"],
      "@constants/*": ["constants/*"],
      "@services/*": ["services/*"],
      "@screens/*": ["navigation/screens/*"]
    }
  }
}
