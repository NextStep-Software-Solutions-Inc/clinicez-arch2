# On-premise web image for the Clinic app: the Expo web export served by nginx, with same-origin `/api` proxied to the
# clinic's own API container and a runtime `config.json`, so one image runs on any clinic LAN without a rebuild and
# without any external network access (fonts, scripts and styles are all bundled; the CSP forbids third-party origins).
#
# Build from the repository root (the app is a bun workspace member):
#   docker build -f apps/clinic-app/deploy/Dockerfile.web -t clinic-web .
#
# Runtime configuration (environment):
#   CLINIC_API_UPSTREAM        required  where nginx forwards /api/, e.g. http://clinic-api:8080
#   CLINIC_PUBLIC_API_URL      optional  apiUrl published in config.json ("/" = same origin, the default)
#   CLINIC_WORKSPACE_REQUIRED  optional  "true" only for multi-clinic hosting (default false)
#   CLINIC_OFFLINE_GRACE_HOURS optional  offline grace period for native devices (default 12)

FROM oven/bun:1 AS build
WORKDIR /repo
COPY . .
RUN bun install --frozen-lockfile
WORKDIR /repo/apps/clinic-app
RUN bun run build:web

FROM nginx:1.27-alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf
COPY apps/clinic-app/deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY apps/clinic-app/deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY apps/clinic-app/deploy/nginx/40-write-config-json.sh /docker-entrypoint.d/40-write-config-json.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-write-config-json.sh /etc/nginx/templates/default.conf.template /etc/nginx/snippets/security-headers.conf \
 && chmod +x /docker-entrypoint.d/40-write-config-json.sh
COPY --from=build /repo/apps/clinic-app/dist /usr/share/nginx/html

ENV NGINX_RESOLVER=127.0.0.11
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
