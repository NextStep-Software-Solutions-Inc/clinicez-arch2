# ---------------------------------------------------------------------------
# Clinic app runtime configuration (Vercel Project Settings -> Environment Variables)
# All EXPO_PUBLIC_* values are inlined into the web bundle at build time, so
# redeploy after changing them.
# ---------------------------------------------------------------------------

# Public Clinic REST API endpoint (HTTPS in production). Highest priority: when set it is used as-is.
EXPO_PUBLIC_CLINIC_API_URL=https://clinic-api.example.com/api/v1

# Optional: derive the API URL instead of setting EXPO_PUBLIC_CLINIC_API_URL.
# Base domain shared by every console, e.g. "<facility>.clinic.<base domain>".
# EXPO_PUBLIC_BASE_DOMAIN=example.com

# Optional: subdomain this app is served from (default "clinic").
# EXPO_PUBLIC_SERVICE_SUBDOMAIN=clinic

# Optional: API URL template. Placeholders: {service}, {baseDomain}, {facility}.
# Default: https://{service}-api.{baseDomain}
# EXPO_PUBLIC_API_URL_TEMPLATE=https://{service}.api.{baseDomain}/api/v1

# Optional: comma separated list of service subdomains recognised by this deployment
# (default "clinic,lab,pharmacy,org").
# EXPO_PUBLIC_SERVICE_SUBDOMAINS=clinic,lab,pharmacy,org

# Optional: root portal URL used for "back to portal" links (default: derived from the base domain).
# EXPO_PUBLIC_PORTAL_URL=https://example.com

