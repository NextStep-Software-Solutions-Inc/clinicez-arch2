# ---------------------------------------------------------------------------
# Portal web configuration (Vercel Project Settings -> Environment Variables)
# NEXT_PUBLIC_* values are inlined into client bundles at build time.
# ---------------------------------------------------------------------------

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Clinic API used by the public intake / verification pages
NEXT_PUBLIC_CLINIC_API_URL=http://localhost:5245

# Base domain shared by every console, e.g. https://<facility>.clinic.<base domain>
# (optional override; defaults to the browser hostname)
NEXT_PUBLIC_BASE_DOMAIN=example.com

# Public origin of this site for SEO metadata (defaults to https://<NEXT_PUBLIC_BASE_DOMAIN>)
# NEXT_PUBLIC_SITE_URL=https://example.com

# Service subdomains recognised by this deployment (comma separated; default "clinic,lab,pharmacy,org")
# NEXT_PUBLIC_SERVICE_SUBDOMAINS=clinic,lab,pharmacy,org
# Subdomain per facility type (defaults shown). Keep aligned with the API's Facility__Subdomains__* settings.
# NEXT_PUBLIC_SUBDOMAIN_CLINIC=clinic
# NEXT_PUBLIC_SUBDOMAIN_LABORATORY=lab
# NEXT_PUBLIC_SUBDOMAIN_PHARMACY=pharmacy
# NEXT_PUBLIC_SUBDOMAIN_ORGANIZATION=org

# Public contact mailboxes (hidden in the UI when empty)
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NEXT_PUBLIC_SALES_EMAIL=sales@example.com
# NEXT_PUBLIC_BILLING_EMAIL=billing@example.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Public base URL of the object storage / CDN used for uploaded documents
# NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://storage.example.com

# Clerk Authentication (Get these from your Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Clerk Custom Redirect Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/sync-auth
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/sync-auth
