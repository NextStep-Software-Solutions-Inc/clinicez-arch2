# ==============================================================================
# Clinic EZ Patient App — Web & Mobile Environment Variables
# ==============================================================================
# In Expo / React Native Web, variables prefixed with EXPO_PUBLIC_ are inlined
# into the client-side JavaScript bundle during "expo export -p web".
# Configure these in the Vercel Dashboard under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# Your Clerk Publishable Key for authenticating patients.
# Development format:  pk_test_...
# Production format:   pk_live_...
# Obtain from: https://dashboard.clerk.com -> Your App -> API Keys
# IMPORTANT for Web: Add your Vercel deployment domain (e.g. *.vercel.app or patient.yourdomain.com)
# to Clerk Dashboard -> Configure -> Domains / Allowed Origins.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# ------------------------------------------------------------------------------
# 2. Patient API Backend Endpoint (REQUIRED)
# ------------------------------------------------------------------------------
# Base URL of the deployed Clinic EZ Patient API.
# Development: https://patient-api-dev.yourdomain.com/api/v1 (or http://localhost:5000/api/v1)
# Production:  https://patient-api.yourdomain.com/api/v1
# IMPORTANT: Ensure your backend Patient API has CORS enabled for your Vercel domain!
EXPO_PUBLIC_API_URL=https://patient-api.yourdomain.com/api/v1

# ------------------------------------------------------------------------------
# 3. Clinic Discovery API (OPTIONAL)
# ------------------------------------------------------------------------------
# Base URL for discovering clinic locations and booking appointments.
# Defaults to http://localhost:5245 if not provided.
EXPO_PUBLIC_CLINIC_API_URL=https://clinic-api.yourdomain.com/api/v1

# ------------------------------------------------------------------------------
# 4. App Variant (OPTIONAL)
# ------------------------------------------------------------------------------
# Defines the environment variant ('production' | 'preview' | 'development').
# Defaults to 'production'.
APP_VARIANT=production

# ------------------------------------------------------------------------------
# 5. Public Portal & Support (OPTIONAL)
# ------------------------------------------------------------------------------
# Root portal URL used to build public prescription verification links (feature hidden when unset).
# EXPO_PUBLIC_PORTAL_URL=https://example.com
# Support mailbox used by Settings -> About (links are inactive when unset).
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
