{
    "cli": {
        "version": ">= 16.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "node": "24.22.1",
            "env": {
                "APP_VARIANT": "development"
            },
            "distribution": "internal",
            "environment": "development",
            "channel": "development",
            "android": {
                "gradleCommand": ":app:assembleDebug",
                "buildType": "apk"
            },
            "ios": {
                "buildConfiguration": "Debug",
                "simulator": true
            }
        },
        "preview": {
            "node": "24.22.1",
            "env": {
                "APP_VARIANT": "preview"
            },
            "distribution": "internal",
            "environment": "preview",
            "channel": "preview",
            "android": {
                "buildType": "apk"
            }
        },
        "staging": {
            "node": "24.22.1",
            "env": {
                "APP_VARIANT": "staging"
            },
            "distribution": "internal",
            "environment": "preview",
            "channel": "staging",
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "node": "24.22.1",
            "env": {
                "APP_VARIANT": "production"
            },
            "distribution": "store",
            "environment": "production",
            "channel": "production",
            "autoIncrement": true
        }
    },
    "submit": {
        "production": {}
    }
}