# ─────────────────────────────────────────────────────────────────
# .easignore  –  patient-app-bun-56
# ─────────────────────────────────────────────────────────────────

# ── Dev tooling & docs ────────────────────────────────────────────
.claude/
CLAUDE.md
AGENTS.md
LICENSE
*.md
!README.md

# ── Local env (never ship secrets) ───────────────────────────────
.env
.env.local
.env.*.local

# ── Editor / OS artefacts ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# ── Test & coverage ───────────────────────────────────────────────
__tests__/
__mocks__/
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.*
jest.setup.*

# ── TypeScript build cache ────────────────────────────────────────
*.tsbuildinfo

# ── Metro bundler ─────────────────────────────────────────────────
.metro-health-check*

# ── Local Expo output ─────────────────────────────────────────────
.expo/
dist/
web-build/

# ── Native folders (generated by EAS remotely) ────────────────────
/android/
/ios/

# ── Local SQLite database instances (KEEP drizzle/ migrations & scripts/!) ───
*.db
*.db-shm
*.db-wal

# ── Lock files (KEEP bun.lock for reproducible Bun installs!) ────
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── CI / Git internals ───────────────────────────────────────────
.github/
.git/

# ── Sibling apps & backend services (when building from monorepo) ─
../../services/
../../apps/clinic-app/
../../apps/portal-web/
../../apps/laboratory-app/
../../apps/pharmacy-app/
../../apps/cashier-app/

# ── Miscellaneous ────────────────────────────────────────────────
*.orig
*.patch
.npmrc
