# ─────────────────────────────────────────────────────────────────
# .easignore  –  patient-app-bun-56
#
# EAS Build inherits .gitignore automatically. This file adds
# extra exclusions that are safe to drop from the upload bundle
# without affecting the remote build.
# ─────────────────────────────────────────────────────────────────

# ── Dev tooling & docs ────────────────────────────────────────────
.claude/
CLAUDE.md
AGENTS.md
LICENSE
*.md
!README.md

# ── Local env (never ship secrets) ───────────────────────────────
.env
.env.local
.env.*.local

# ── Editor / OS artefacts ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# ── Test & coverage ───────────────────────────────────────────────
__tests__/
__mocks__/
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.*
jest.setup.*

# ── TypeScript build cache ────────────────────────────────────────
*.tsbuildinfo

# ── Metro bundler ─────────────────────────────────────────────────
.metro-health-check*

# ── Local Expo output (already in .gitignore, belt-and-suspenders) ─
.expo/
dist/
web-build/

# ── Native folders (generated by EAS remotely, not needed in upload) ─
/android/
/ios/

# ── Local SQLite / Drizzle artefacts ─────────────────────────────
drizzle/
*.db
*.db-shm
*.db-wal

# ── Scripts (only used locally) ───────────────────────────────────
scripts/

# ── Lock files (EAS uses its own install; keep package.json only) ─
bun.lock
package-lock.json
yarn.lock

# ── CI / Git internals ───────────────────────────────────────────
.github/
.git/

# ── Miscellaneous large / unnecessary files ──────────────────────
*.orig
*.patch
.npmrc
