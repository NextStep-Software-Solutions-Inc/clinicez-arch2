# On-premise web image for the Cashier app: the Expo web export served by nginx, with same-origin `/api` proxied to the
# cell's billing-api container and a runtime `config.json`, so one image runs on any LAN without a rebuild and without
# any external network access (the CSP forbids third-party origins).
#
# Mirrors apps/pharmacy-app/deploy/Dockerfile.web. Build from the repository root (the app is a bun workspace member):
#   docker build -f apps/cashier-app/deploy/Dockerfile.web -t cashier-web .
#
# Runtime configuration (environment), published in /config.json (read by services/runtimeConfig.ts):
#   BILLING_API_UPSTREAM          required  where nginx forwards /api/, e.g. http://billing-api:8080 (infrastructure only)
#   EXPO_PUBLIC_BILLING_API_URL   optional  default "/" = same origin (nginx proxies /api)
#   EXPO_PUBLIC_BASE_DOMAIN, EXPO_PUBLIC_SERVICE_SUBDOMAIN(S), EXPO_PUBLIC_API_URL_TEMPLATE, EXPO_PUBLIC_PORTAL_URL,
#   EXPO_PUBLIC_STORAGE_PUBLIC_URL, EXPO_PUBLIC_OFFLINE_GRACE_HOURS   optional

FROM oven/bun:1 AS build
WORKDIR /repo
COPY . .
RUN bun install --frozen-lockfile
WORKDIR /repo/apps/cashier-app
RUN bun run build:web

FROM nginx:1.27-alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf
COPY apps/cashier-app/deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY apps/cashier-app/deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY apps/cashier-app/deploy/nginx/40-write-config-json.sh /docker-entrypoint.d/40-write-config-json.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-write-config-json.sh /etc/nginx/templates/default.conf.template /etc/nginx/snippets/security-headers.conf \
 && chmod +x /docker-entrypoint.d/40-write-config-json.sh
COPY --from=build /repo/apps/cashier-app/dist /usr/share/nginx/html

ENV NGINX_RESOLVER=127.0.0.11
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
