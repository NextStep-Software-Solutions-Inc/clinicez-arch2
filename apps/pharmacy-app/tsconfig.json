{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strict": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@clinicez/design-tokens": ["../../packages/design-tokens/src"],
      "@clinicez/comms-sdk": ["../../packages/comms-sdk/src"],
      "@clinicez/comms-sdk/*": ["../../packages/comms-sdk/src/*"],
      "@ui/*": ["components/ui/*"],
      "@ui": ["components/ui"],
      "@services/*": ["services/*"],
      "@screens/*": ["navigation/screens/*"]
    }
  },
  "exclude": ["node_modules", "tests"]
}
