{
  "expo": {
    "name": "Clinic EZ Pharmacy App",
    "slug": "clinicez-pharmacy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Clinic EZ Pharmacy uses the camera to scan the QR code on a patient's prescription." }
      ],
      [
        "expo-build-properties",
        { "android": { "usesCleartextTraffic": true } }
      ]
    ]
  }
}
