<Project>
  <!-- Global MSBuild settings applied to all projects under the repository root -->
  <PropertyGroup>
    <!-- Treat all compiler warnings as errors. To opt-out in a specific project, set
         <TreatWarningsAsErrors>false</TreatWarningsAsErrors> in that project's .csproj -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep NuGet security audit advisory warnings as warnings, not breaking build errors -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Suppress MSB3277 assembly version mismatch warning between transitive EF dependencies -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
</Project>
