<Project>
  <!-- Global MSBuild settings applied to all projects under the repository root -->
  <PropertyGroup>
    <!-- Treat all compiler warnings as errors. To opt-out in a specific project, set
         <TreatWarningsAsErrors>false</TreatWarningsAsErrors> in that project's .csproj -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1510;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
