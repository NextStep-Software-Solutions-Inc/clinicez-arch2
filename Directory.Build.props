<Project>
  <!-- Global MSBuild settings applied to all projects under the repository root -->
  <PropertyGroup>
    <!-- Treat all compiler warnings as errors. To opt-out in a specific project, set
         <TreatWarningsAsErrors>false</TreatWarningsAsErrors> in that project's .csproj -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Patch System.Security.Cryptography.Pkcs globally to secure 10.0.13 version (CVE-2026-70162 / GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Ensure System.Security.Cryptography.Xml resolves to secure 10.0.13 version across all projects -->
    <PackageReference Update="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
</Project>
