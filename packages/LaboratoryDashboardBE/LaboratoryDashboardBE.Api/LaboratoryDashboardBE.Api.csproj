<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LaboratoryDashboardBE.Api</RootNamespace>
    <UserSecretsId>fb62b279-ede1-47c1-b624-b2548dbbc433</UserSecretsId>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Sieve" Version="2.5.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaboratoryDashboardBE.Application\LaboratoryDashboardBE.Application.csproj" />
    <ProjectReference Include="..\LaboratoryDashboardBE.Infrastructure\LaboratoryDashboardBE.Infrastructure.csproj" />
    <ProjectReference Include="..\..\CLINICEZ.Shared\CLINICEZ.Shared.csproj" />
  </ItemGroup>

</Project>






