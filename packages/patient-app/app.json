{
	"expo": {
		"name": "clinicez-patient-app",
		"slug": "clinicez-patient-app",
		"version": "1.0.1",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "clinicezpatientapp",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.nextstepsoftware.clinicez.patient",
			"icon": {
				"light": "./assets/images/ios-icon-default.png",
				"dark": "./assets/images/ios-icon-dark.png",
				"tinted": "./assets/images/ios-icon-tinted.png"
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundColor": "#ffffff",
				"monochromeImage": "./assets/images/android-icon-monochrome.png",
				"backgroundImage": "./assets/images/android-icon-background.png"
			},
			"package": "com.nextstepsoftware.clinicez.patient"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-sqlite",
			"@clerk/expo",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"ios": {
						"image": "./assets/images/iOS.png",
						"resizeMode": "contain"
					},
					"android": {
						"image": "./assets/images/android-splash.png",
						"resizeMode": "contain"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "972b1787-7d02-4820-ae35-9a11457d2b8a"
			}
		},
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"fallbackToCacheTimeout": 0,
			"enabled": true,
			"url": "https://u.expo.dev/972b1787-7d02-4820-ae35-9a11457d2b8a"
		}
	}
}