# docker-compose environment variables — copy this file to .env and fill in real values
# .env is gitignored; this file is committed as documentation only

# PostgreSQL
POSTGRES_USER=patientapp
POSTGRES_PASSWORD=changeme_in_production

# Clerk Authentication
CLERK_AUTHORITY=https://clerk.your-domain.com
CLERK_AUDIENCE=your-api-audience

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_BUCKET_NAME=clinicez-patient-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Hangfire Dashboard Basic Auth
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=changeme_in_production
